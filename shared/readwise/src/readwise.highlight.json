{
  "id": "readwise.highlight",
  "label": "Readwise Highlight",
  "description": "A Readwise highlight shared by independently usable Reader and Highlights connectors.",
  "parent": "core.highlight",
  "fields": {
    "readwise_id": {
      "type": "string",
      "description": "The upstream Readwise record ID."
    },
    "account": {
      "type": "string",
      "required": true,
      "description": "The stable, nonsecret account label used in the natural key."
    },
    "external_id": {
      "type": "string",
      "description": "The identifier in the upstream source system; retained for Reader linking."
    },
    "tags": {
      "type": "array",
      "items_type": "string",
      "description": "Trimmed, distinct Readwise tag names, preserving case and Unicode."
    },
    "readwise_source_id": {
      "type": "string",
      "description": "The source user_book_id in Readwise, distinct from the item natural key."
    },
    "readwise_color": {
      "type": "string",
      "description": "The original highlight color, including values core.highlight cannot represent."
    },
    "location_type": {
      "type": "string",
      "description": "The original locator kind, including vendor-specific kinds."
    },
    "highlighted_at": {
      "type": "string",
      "description": "The original highlighting timestamp."
    },
    "readwise_created_at": {
      "type": "string",
      "description": "The original creation timestamp."
    },
    "readwise_updated_at": {
      "type": "string",
      "description": "The original update timestamp."
    },
    "url": {
      "type": "string",
      "description": "The highlight URL as Readwise supplied it."
    },
    "readwise_url": {
      "type": "string",
      "description": "The highlight page in Readwise."
    },
    "location": {
      "type": "integer",
      "description": "The original numeric start location."
    },
    "is_favorite": {
      "type": "boolean",
      "description": "The flag supplied by Readwise."
    },
    "is_discard": {
      "type": "boolean",
      "description": "The flag supplied by Readwise."
    },
    "canonical_key": {
      "type": "string",
      "description": "Account-scoped canonical identity shared by Reader and Highlights."
    },
    "reader_id": {
      "type": "string",
      "description": "The verified Reader document or highlight ID."
    },
    "reader_managed": {
      "type": "boolean",
      "description": "Whether Reader owns the shared mutable fields."
    },
    "reader_parent_id": {
      "type": "string",
      "description": "The Reader parent document ID, when present."
    },
    "reader_metadata": {
      "type": "object",
      "description": "Reader metadata retained without coercing vendor values."
    },
    "reader_notes": {
      "type": "object",
      "description": "Reader note records keyed by their vendor IDs."
    },
    "reader_text_files": {
      "type": "array",
      "items_type": "string",
      "description": "Natural keys of file items preserving over-limit text completely."
    },
    "reader_location": {
      "type": "string",
      "description": "The original Reader location."
    },
    "reader_source": {
      "type": "string",
      "description": "The original Reader source."
    },
    "reader_site_name": {
      "type": "string",
      "description": "The original Reader site name."
    },
    "reader_reading_time": {
      "type": "string",
      "description": "The original Reader reading time."
    },
    "reader_listening_time": {
      "type": "string",
      "description": "The original Reader listening time."
    },
    "reader_published_date": {
      "type": "string",
      "description": "The original Reader published date."
    },
    "reader_created_at": {
      "type": "string",
      "description": "The original Reader created at."
    },
    "reader_updated_at": {
      "type": "string",
      "description": "The original Reader updated at."
    },
    "reader_first_opened_at": {
      "type": "string",
      "description": "The original Reader first opened at."
    },
    "reader_last_opened_at": {
      "type": "string",
      "description": "The original Reader last opened at."
    },
    "reader_saved_at": {
      "type": "string",
      "description": "The original Reader saved at."
    },
    "reader_last_moved_at": {
      "type": "string",
      "description": "The original Reader last moved at."
    },
    "reader_highlight_location": {
      "type": "string",
      "description": "The original Reader highlight location."
    },
    "reader_url": {
      "type": "string",
      "description": "The original Reader url."
    },
    "reader_source_url": {
      "type": "string",
      "description": "The original Reader source url."
    },
    "reader_image_url": {
      "type": "string",
      "description": "The original Reader image url."
    },
    "reader_language": {
      "type": "string",
      "description": "The original Reader language."
    },
    "reader_reading_progress": {
      "type": "number",
      "description": "The original Reader reading progress."
    },
    "reader_word_count": {
      "type": "integer",
      "description": "The original Reader word count."
    },
    "reader_highlight_offset": {
      "type": "integer",
      "description": "The original Reader highlight offset."
    },
    "readwise_text": {
      "type": "string",
      "description": "Export passage when it differs from the canonical Reader passage."
    },
    "category": {
      "type": "string",
      "description": "The original Reader category."
    },
    "reader_create": {
      "type": "boolean",
      "description": "Explicit intent to create this local item in Reader; cleared after its Reader identity is confirmed."
    }
  },
  "display_hints": {
    "title_field": "text",
    "body_field": "note"
  },
  "link_field": "canonical_key"
}
